{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Matching": {
    "EventTransport": { "Enabled": false },
    "Scoring": {
      "RulesVersion": "deterministic-v2",
      "JobTitleWeight": 0.30,
      "SkillsWeight": 0.50,
      "LocationWeight": 0.20
    }
  },
  "Recommendations": {
    "Processing": {
      "MaxUniqueJobs": 10000,
      "MaxSourcePages": 200,
      "TimeoutSeconds": 30
    }
  }
}
