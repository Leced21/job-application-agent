<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\..\shared\JobApplicationAgent.Observability\CorrelationIdMiddleware.cs" Link="Observability\CorrelationIdMiddleware.cs" />
    <Compile Include="..\..\shared\JobApplicationAgent.Observability\HttpRequestMetrics.cs" Link="Observability\HttpRequestMetrics.cs" />
    <Compile Include="..\..\shared\JobApplicationAgent.Observability\ServiceHealthChecks.cs" Link="Observability\ServiceHealthChecks.cs" />
    <PackageReference Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" Version="10.0.12" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.12">
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <!-- Pin the transitive DataProtection dependency to its patched release; it is also in the shared framework. -->
    <PackageReference Include="System.Security.Cryptography.Xml" Version="10.0.13" NoWarn="NU1510" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
    <PackageReference Include="OpenIddict.AspNetCore" Version="7.7.2" />
    <PackageReference Include="OpenIddict.Client" Version="7.7.2" />
    <PackageReference Include="OpenIddict.Client.SystemNetHttp" Version="7.7.2" />
    <PackageReference Include="OpenIddict.EntityFrameworkCore" Version="7.7.2" />
    <PackageReference Include="Yarp.ReverseProxy" Version="2.3.0" />
  </ItemGroup>

</Project>
