{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp.ReverseProxy": "Information"
    }
  },
  "AllowedHosts": "*",
  "ReverseProxy": {
    "Routes": {
      "documents-route": {
        "ClusterId": "documents-cluster",
        "Match": { "Path": "/api/v1/documents/{**catch-all}" }
      },
      "collection-route": {
        "ClusterId": "collection-cluster",
        "Match": { "Path": "/api/v1/collection/{**catch-all}" }
      },
      "matching-route": {
        "ClusterId": "matching-cluster",
        "Match": { "Path": "/api/v1/matching/{**catch-all}" }
      },
      "profile-route": {
        "ClusterId": "profile-cluster",
        "Match": {
          "Path": "/api/v1/profile/{**catch-all}"
        }
      },
      "job-route": {
        "ClusterId": "job-cluster",
        "Match": {
          "Path": "/api/v1/jobs/{**catch-all}"
        }
      },
      "agents-route": {
        "ClusterId": "agents-cluster",
        "Match": { "Path": "/api/v1/agents/{**catch-all}" }
      },
      "applications-route": {
        "ClusterId": "applications-cluster",
        "Match": { "Path": "/api/v1/applications/{**catch-all}" }
      }
    },
    "Clusters": {
      "documents-cluster": {
        "Destinations": { "documents-api": { "Address": "http://localhost:5005/" } }
      },
      "collection-cluster": {
        "Destinations": { "collection-api": { "Address": "http://localhost:5004/" } }
      },
      "matching-cluster": {
        "Destinations": {
          "matching-api": { "Address": "http://localhost:5186/" }
        }
      },
      "profile-cluster": {
        "Destinations": {
          "profile-api": {
            "Address": "http://localhost:5001/"
          }
        }
      },
      "job-cluster": {
        "Destinations": {
          "job-api": {
            "Address": "http://localhost:5002/"
          }
        }
      },
      "agents-cluster": {
        "Destinations": { "agents-api": { "Address": "http://localhost:5008/" } }
      },
      "applications-cluster": {
        "Destinations": { "applications-api": { "Address": "http://localhost:5007/" } }
      }
    }
  }
}
