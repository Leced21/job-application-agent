<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../../src/services/Job/JobApplicationAgent.Job.Api/JobApplicationAgent.Job.Api.csproj" Aliases="JobSource" />
    <ProjectReference Include="../../../src/services/Profile/JobApplicationAgent.Profile.Api/JobApplicationAgent.Profile.Api.csproj" Aliases="ProfileReceiver" />
    <ProjectReference Include="../../../src/services/Documents/JobApplicationAgent.Documents.Api/JobApplicationAgent.Documents.Api.csproj" />
    <ProjectReference Include="../../../src/services/Documents/JobApplicationAgent.Documents.ExtractionWorker/JobApplicationAgent.Documents.ExtractionWorker.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
    <Using Include="Xunit" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.12" />
    <PackageReference Include="Testcontainers.PostgreSql" Version="4.15.0" />
    <PackageReference Include="PdfPig" Version="0.1.16" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="../JobApplicationAgent.Documents.UnitTests/ResumeSamples.cs" Link="ResumeSamples.cs" />
    <Compile Include="../JobApplicationAgent.Documents.UnitTests/CompositionSamples.cs" Link="CompositionSamples.cs" />
  </ItemGroup>
  <Target Name="CopyExtractionWorker" AfterTargets="Build">
    <MSBuild Projects="../../../src/services/Documents/JobApplicationAgent.Documents.ExtractionWorker/JobApplicationAgent.Documents.ExtractionWorker.csproj" Targets="GetTargetPath" Properties="Configuration=$(Configuration)">
      <Output TaskParameter="TargetOutputs" ItemName="ExtractionWorkerTarget" />
    </MSBuild>
    <PropertyGroup><ExtractionWorkerDirectory>@(ExtractionWorkerTarget->'%(RootDir)%(Directory)')</ExtractionWorkerDirectory></PropertyGroup>
    <ItemGroup><ExtractionWorkerAssets Include="$(ExtractionWorkerDirectory)*" /></ItemGroup>
    <Copy SourceFiles="@(ExtractionWorkerAssets)" DestinationFolder="$(OutDir)ExtractionWorker" SkipUnchangedFiles="true" />
  </Target>
</Project>
